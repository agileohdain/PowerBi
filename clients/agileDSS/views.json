{
  "labels": {
    "Liege": "Liège",
    "Quebec": "Québec",
    "Montreal": "Montréal",
    "Cervelo": "Cervélo",
    "Chaine": "Chaîne",
    "Pneu arriere": "Pneu arrière",
    "Plaquettes arriere": "Plaquettes arrière",
    "Depasse": "Dépassé"
  },
  "pages": [
    {
      "name": "Cyclistes",
      "desc": "Suivi de l'activité des cyclistes : pratique (km, sorties), répartition géographique et affectations des vélos.",
      "subs": [
        {
          "name": "Vue d'ensemble",
          "kpis": [
            {"label": "Cyclistes actifs", "agg": "active", "yoy": true, "fmt": "int", "sub": "actifs en {CUR_YEAR}"},
            {"label": "Kilomètres totaux", "agg": "sum", "measure": "NB_KM", "yoy": true, "fmt": "km", "sub": "parcourus en {CUR_YEAR}"},
            {"label": "Sorties", "agg": "sum", "measure": "_count", "yoy": true, "fmt": "int", "sub": "réalisées en {CUR_YEAR}"},
            {"label": "Km / cycliste", "agg": "ratio", "num": "NB_KM", "den": "ACTIVE", "yoy": true, "fmt": "km", "sub": "en moyenne en {CUR_YEAR}"},
            {"label": "Durée moy. / sortie", "agg": "ratio", "num": "MINUTES", "den": "_count", "yoy": true, "fmt": "dur", "sub": "par sortie · {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "line", "measure": "NB_KM", "title": "Kilomètres par mois", "unit": "km"},
            {"type": "line", "measure": "_count", "title": "Sorties par mois", "unit": "int"},
            {"type": "donut", "from": "DIM_COUNTS.Pays", "top": 6, "title": "Répartition des cyclistes par pays", "unit": "int", "centerSub": "cyclistes", "sub": "total parc"},
            {"type": "hbar", "from": "BY_DIM.Ville.NB_KM", "top": 10, "title": "Kilomètres par ville", "unit": "km", "sub": "année {CUR_YEAR}"}
          ]
        },
        {
          "name": "Répartition géographique",
          "kpis": [
            {"label": "Pays couverts", "agg": "scalar", "from": "SCALARS.NB_PAYS", "fmt": "int", "sub": "pays présents"},
            {"label": "Villes couvertes", "agg": "scalar", "from": "SCALARS.NB_VILLE", "fmt": "int", "sub": "villes actives"},
            {"label": "Cyclistes par pays", "agg": "ratio", "num": "SCALARS.NB_DIM_UTILISATEUR", "den": "SCALARS.NB_PAYS", "fmt": "f0", "sub": "en moyenne par pays"}
          ],
          "visuals": [
            {"type": "donut", "from": "BY_DIM.Pays.NB_KM", "top": 6, "title": "Part des kilomètres par pays", "unit": "km", "centerSub": "km · {CUR_YEAR}", "sub": "année {CUR_YEAR}"},
            {"type": "hbar", "from": "DIM_COUNTS.Ville", "top": 10, "title": "Cyclistes par ville", "unit": "int", "sub": "total parc"},
            {"type": "hbar", "from": "BY_DIM.Ville.NB_KM", "top": 10, "title": "Kilomètres par ville", "unit": "km", "sub": "année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.Pays.NB_KM", "title": "Détail par pays", "sub": "année {CUR_YEAR}", "cols": [
              {"label": "Pays", "source": "name"},
              {"label": "Km", "source": "self", "fmt": "km", "num": true},
              {"label": "Minutes", "source": "measure:MINUTES", "fmt": "int", "num": true},
              {"label": "Sorties", "source": "measure:_count", "fmt": "int", "num": true}
            ]}
          ]
        },
        {
          "name": "Affectations vélos",
          "kpis": [
            {"label": "Cyclistes avec vélo", "agg": "scalar", "from": "SCALARS.DISTINCT_ASSOC_UTILISATEUR_VELO_ID_UTILISATEUR", "fmt": "int", "sub": "cyclistes équipés"},
            {"label": "Vélos attribués", "agg": "scalar", "from": "SCALARS.DISTINCT_ASSOC_UTILISATEUR_VELO_ID_VELO", "fmt": "int", "sub": "vélos du parc attribués"},
            {"label": "Ratio vélos / cycliste", "agg": "ratio", "num": "SCALARS.DISTINCT_ASSOC_UTILISATEUR_VELO_ID_VELO", "den": "SCALARS.DISTINCT_ASSOC_UTILISATEUR_VELO_ID_UTILISATEUR", "fmt": "f1", "sub": "par cycliste équipé"}
          ],
          "visuals": [
            {"type": "donut", "from": "DIM_COUNTS.Marque", "top": 6, "title": "Vélos attribués par marque", "unit": "int", "centerSub": "vélos", "sub": "total parc"},
            {"type": "hbar", "from": "BY_DIM.Marque.NB_KM", "top": 10, "title": "Kilomètres par marque", "unit": "km", "sub": "année {CUR_YEAR}"},
            {"type": "line", "measure": "_count", "title": "Sorties par mois", "unit": "int"}
          ]
        }
      ]
    },
    {
      "name": "Flotte vélos",
      "desc": "État et usage de la flotte de vélos : composition du parc, marques et usure des composants.",
      "subs": [
        {
          "name": "Vue d'ensemble",
          "kpis": [
            {"label": "Vélos en flotte", "agg": "scalar", "from": "SCALARS.NB_DIM_VELO", "fmt": "int", "sub": "vélos du parc"},
            {"label": "Marques distinctes", "agg": "scalar", "from": "SCALARS.NB_MARQUE", "fmt": "int", "sub": "marques au parc"},
            {"label": "Année moyenne du parc", "agg": "scalar", "from": "SCALARS.AVG_ANNEE_SORTIE", "fmt": "f0", "sub": "année de sortie moyenne"},
            {"label": "Km total parcouru", "agg": "sum", "measure": "NB_KM", "yoy": true, "fmt": "km", "sub": "par la flotte en {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "line", "measure": "NB_KM", "title": "Kilomètres par mois", "unit": "km"},
            {"type": "hbar", "from": "DIM_COUNTS.Marque", "top": 10, "title": "Vélos par marque", "unit": "int", "sub": "total parc"},
            {"type": "donut", "from": "CATEGORY_COUNTS.DIM_COMPOSANT.Categorie_Composant", "top": 5, "title": "Composants par catégorie", "unit": "int", "centerSub": "composants", "sub": "usure suivie"},
            {"type": "donut", "from": "CATEGORY_COUNTS.FAIT_USURE_COMPOSANT.Statut_Alerte", "top": 6, "title": "État d'usure des composants", "unit": "int", "centerSub": "composants", "sub": "statut d'alerte"}
          ]
        },
        {
          "name": "Répartition par marque",
          "kpis": [
            {"label": "Vélos par marque", "agg": "scalar", "from": "SCALARS.NB_DIM_VELO", "fmt": "int", "sub": "vélos du parc"},
            {"label": "Marque dominante", "agg": "top", "from": "DIM_COUNTS.Marque", "fmt": "text", "sub": "en nombre de vélos"}
          ],
          "visuals": [
            {"type": "donut", "from": "DIM_COUNTS.Marque", "top": 6, "title": "Part du parc par marque", "unit": "int", "centerSub": "vélos", "sub": "total parc"},
            {"type": "hbar", "from": "BY_DIM.Marque.NB_KM", "top": 10, "title": "Kilomètres par marque", "unit": "km", "sub": "année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.Marque.NB_KM", "title": "Détail par marque", "sub": "kilomètres · sorties · minutes — {CUR_YEAR}", "sortBy": "measure:NB_KM", "cols": [
              {"label": "Marque", "source": "name"},
              {"label": "Km", "source": "self", "fmt": "km", "num": true},
              {"label": "Sorties", "source": "measure:_count", "fmt": "int", "num": true},
              {"label": "Minutes", "source": "measure:MINUTES", "fmt": "int", "num": true}
            ]}
          ]
        }
      ]
    }
  ]
}
