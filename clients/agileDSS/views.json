{
  "labels": {
    "Deplacements": "Déplacements",
    "Interessement": "Intéressement",
    "Equipements": "Équipements",
    "Vehicules": "Véhicules"
  },
  "pages": [
    {
      "name": "Performance & Rentabilité",
      "desc": "Performance opérationnelle et rentabilité — chiffre d'affaires, marges, EBITDA et résultat net.",
      "subs": [
        {
          "name": "Vue d'ensemble",
          "kpis": [
            {"label": "Chiffre d'affaires", "agg": "sum", "measure": "REVENUS", "yoy": true, "fmt": "eur", "sub": "en {CUR_YEAR}"},
            {"label": "Résultat net", "agg": "sum", "measure": "RESULTAT_NET", "yoy": true, "fmt": "eur", "sub": "en {CUR_YEAR}"},
            {"label": "Taux de marge nette", "agg": "ratio", "num": "RESULTAT_NET", "den": "REVENUS", "yoy": true, "fmt": "pct", "sub": "année {CUR_YEAR}"},
            {"label": "Clients actifs", "agg": "active", "yoy": true, "fmt": "int", "sub": "actifs en {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "line", "measure": "REVENUS", "title": "Évolution du chiffre d'affaires", "unit": "eur"},
            {"type": "line", "measure": "RESULTAT_NET", "title": "Résultat net mensuel", "unit": "eur"},
            {"type": "donut", "from": "BY_DIM.Segment.REVENUS", "top": 6, "title": "CA par segment", "unit": "eur", "centerSub": "total CA", "sub": "année {CUR_YEAR}"},
            {"type": "hbar", "from": "BY_DIM.Entite.REVENUS", "top": 10, "title": "CA par département", "unit": "eur", "sub": "année {CUR_YEAR}"}
          ]
        },
        {
          "name": "Marges & EBITDA",
          "kpis": [
            {"label": "Marge brute", "agg": "sum", "measure": "MARGE_BRUTE", "yoy": true, "fmt": "eur", "sub": "en {CUR_YEAR}"},
            {"label": "Taux de marge brute", "agg": "ratio", "num": "MARGE_BRUTE", "den": "REVENUS", "yoy": true, "fmt": "pct", "sub": "année {CUR_YEAR}"},
            {"label": "EBITDA", "agg": "sum", "measure": "EBITDA", "yoy": true, "fmt": "eur", "sub": "en {CUR_YEAR}"},
            {"label": "Taux de marge EBITDA", "agg": "ratio", "num": "EBITDA", "den": "REVENUS", "yoy": true, "fmt": "pct", "sub": "année {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "ratio-line", "num": "MARGE_BRUTE", "den": "REVENUS", "title": "Taux de marge brute mensuel", "unit": "pct"},
            {"type": "line", "measure": "EBITDA", "title": "EBITDA mensuel", "unit": "eur"},
            {"type": "hbar", "from": "BY_DIM.Entite.EBITDA", "top": 10, "title": "EBITDA par département", "unit": "eur", "sub": "année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.Entite.REVENUS", "title": "Détail par département", "sub": "année {CUR_YEAR}",
             "cols": [
               {"label": "Entité", "source": "name"},
               {"label": "CA", "source": "self", "fmt": "eur", "num": true},
               {"label": "Marge brute", "source": "measure:MARGE_BRUTE", "fmt": "eur", "num": true},
               {"label": "EBITDA", "source": "measure:EBITDA", "fmt": "eur", "num": true}
             ]}
          ]
        }
      ]
    },
    {
      "name": "Structure des coûts",
      "desc": "Structure des coûts — charges d'exploitation, masse salariale et investissements (CAPEX).",
      "subs": [
        {
          "name": "Charges d'exploitation",
          "kpis": [
            {"label": "OPEX", "agg": "sum", "measure": "OPEX", "yoy": true, "fmt": "eur", "sub": "en {CUR_YEAR}"},
            {"label": "Couverture des charges", "agg": "ratio", "num": "REVENUS", "den": "OPEX", "yoy": true, "fmt": "f1", "sub": "CA / OPEX · {CUR_YEAR}"},
            {"label": "Part OPEX sur CA", "agg": "ratio", "num": "OPEX", "den": "REVENUS", "yoy": true, "fmt": "pct", "sub": "année {CUR_YEAR}"},
            {"label": "Compte de charges dominant", "agg": "top", "from": "BY_DIM.Compte.OPEX", "fmt": "text", "sub": "en tête"}
          ],
          "visuals": [
            {"type": "line", "measure": "OPEX", "title": "OPEX mensuel", "unit": "eur"},
            {"type": "stacked-bars", "from": "BY_DIM.Entite.OPEX", "title": "OPEX mensuel par département", "unit": "eur"},
            {"type": "hbar", "from": "BY_DIM.Compte.OPEX", "top": 10, "title": "Top charges par compte", "unit": "eur", "sub": "année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.Entite.OPEX", "title": "Détail par département", "sub": "année {CUR_YEAR}",
             "cols": [
               {"label": "Entité", "source": "name"},
               {"label": "OPEX", "source": "self", "fmt": "eur", "num": true},
               {"label": "CA", "source": "measure:REVENUS", "fmt": "eur", "num": true},
               {"label": "Masse salariale", "source": "measure:MASSE_SALARIALE", "fmt": "eur", "num": true}
             ]}
          ]
        },
        {
          "name": "Masse salariale",
          "kpis": [
            {"label": "Masse salariale", "agg": "sum", "measure": "MASSE_SALARIALE", "yoy": true, "fmt": "eur", "sub": "en {CUR_YEAR}"},
            {"label": "Masse salariale sur CA", "agg": "ratio", "num": "MASSE_SALARIALE", "den": "REVENUS", "yoy": true, "fmt": "pct", "sub": "année {CUR_YEAR}"},
            {"label": "Département en tête", "agg": "top", "from": "BY_DIM.Entite.MASSE_SALARIALE", "fmt": "text", "sub": "masse salariale"}
          ],
          "visuals": [
            {"type": "line", "measure": "MASSE_SALARIALE", "title": "Masse salariale mensuelle", "unit": "eur"},
            {"type": "hbar", "from": "BY_DIM.Entite.MASSE_SALARIALE", "top": 10, "title": "Masse salariale par département", "unit": "eur", "sub": "année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.Entite.MASSE_SALARIALE", "title": "Détail par département", "sub": "année {CUR_YEAR}",
             "cols": [
               {"label": "Entité", "source": "name"},
               {"label": "Masse salariale", "source": "self", "fmt": "eur", "num": true},
               {"label": "CA", "source": "measure:REVENUS", "fmt": "eur", "num": true}
             ]}
          ]
        },
        {
          "name": "Investissements (CAPEX)",
          "kpis": [
            {"label": "CAPEX", "agg": "sum", "measure": "CAPEX", "yoy": true, "fmt": "eur", "sub": "en {CUR_YEAR}"},
            {"label": "Poids des investissements", "agg": "ratio", "num": "CAPEX", "den": "REVENUS", "yoy": true, "fmt": "pct", "sub": "année {CUR_YEAR}"},
            {"label": "Compte d'investissement dominant", "agg": "top", "from": "BY_DIM.Compte.CAPEX", "fmt": "text", "sub": "en tête"}
          ],
          "visuals": [
            {"type": "line", "measure": "CAPEX", "title": "CAPEX mensuel", "unit": "eur"},
            {"type": "hbar", "from": "BY_DIM.Compte.CAPEX", "top": 10, "title": "Top comptes d'investissement", "unit": "eur", "sub": "année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.Entite.CAPEX", "title": "CAPEX par département", "sub": "année {CUR_YEAR}",
             "cols": [
               {"label": "Entité", "source": "name"},
               {"label": "CAPEX", "source": "self", "fmt": "eur", "num": true},
               {"label": "CA", "source": "measure:REVENUS", "fmt": "eur", "num": true}
             ]}
          ]
        }
      ]
    }
  ]
}
