{
  "labels": {},

  "pages": [
    {
      "name": "Synthèse",
      "desc": "Panorama financier : flux, activité, trésorerie et rendement du portefeuille agiledss sur l'année N.",
      "subs": [
        {
          "name": "Vue d'ensemble",
          "kpis": [
            {"label": "Flux financier", "agg": "sum", "measure": "MONTANT", "yoy": true, "fmt": "int", "sub": "k€ en {CUR_YEAR}"},
            {"label": "Clients actifs", "agg": "active", "yoy": true, "fmt": "int", "sub": "facturés en {CUR_YEAR}"},
            {"label": "Réalisation budgétaire", "agg": "ratio", "num": "MONTANT", "den": "MONTANT_PREVU", "yoy": true, "fmt": "pct", "sub": "réalisé vs prévu · {CUR_YEAR}"},
            {"label": "DSO moyen", "agg": "scalar", "from": "SCALARS.AVG_DELAI_PAIEMENT", "fmt": "int", "sub": "jours · {CUR_YEAR}"},
            {"label": "ROI moyen", "agg": "scalar", "from": "SCALARS.AVG_ROI", "fmt": "pct", "sub": "portefeuille {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "line", "measure": "MONTANT", "title": "Flux financier par mois", "unit": "int", "unitLabel": "k€"},
            {"type": "donut", "from": "BY_DIM.Categorie.MONTANT", "top": 6, "title": "Répartition par nature", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"},
            {"type": "hbar", "from": "BY_DIM.SousFamille.MONTANT", "top": 10, "title": "Top postes financiers", "unit": "int", "sub": "k€ · année {CUR_YEAR}"},
            {"type": "hbar", "from": "BY_DIM.Zone.MONTANT", "top": 10, "title": "Flux par zone", "unit": "int", "sub": "k€ · année {CUR_YEAR}"}
          ]
        }
      ]
    },
    {
      "name": "Performance & Rentabilité",
      "desc": "Chiffre d'affaires, volume d'activité, réalisation budgétaire et structure des coûts.",
      "subs": [
        {
          "name": "Chiffre d'affaires & volume",
          "kpis": [
            {"label": "Volume financier", "agg": "sum", "measure": "MONTANT", "yoy": true, "fmt": "int", "sub": "k€ en {CUR_YEAR}"},
            {"label": "Écritures traitées", "agg": "sum", "measure": "_count", "yoy": true, "fmt": "int", "sub": "en {CUR_YEAR}"},
            {"label": "Taux de réalisation du budget", "agg": "ratio", "num": "MONTANT", "den": "MONTANT_PREVU", "yoy": true, "fmt": "pct", "sub": "{CUR_YEAR}"},
            {"label": "Segment client dominant", "agg": "top", "from": "DIM_COUNTS.Segment", "fmt": "text", "sub": "clients couverts"}
          ],
          "visuals": [
            {"type": "stacked-bars", "from": "BY_DIM.Categorie.MONTANT", "title": "Flux mensuel par nature", "unit": "int", "unitLabel": "k€", "sub": "k€ · {CUR_YEAR}"},
            {"type": "ratio-line", "num": "MONTANT", "den": "MONTANT_PREVU", "title": "Taux de réalisation mensuel", "unit": "pct"},
            {"type": "donut", "from": "BY_DIM.Segment.MONTANT", "top": 6, "title": "Flux par segment client", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"},
            {"type": "donut", "from": "BY_DIM.Region.MONTANT", "top": 6, "title": "Flux par région client", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"}
          ]
        },
        {
          "name": "Structure des coûts",
          "kpis": [
            {"label": "Budget engagé", "agg": "sum", "measure": "MONTANT_PREVU", "yoy": true, "fmt": "int", "sub": "k€ prévus en {CUR_YEAR}"},
            {"label": "Taux d'engagement", "agg": "ratio", "num": "MONTANT", "den": "MONTANT_PREVU", "yoy": true, "fmt": "pct", "sub": "réalisé vs prévu · {CUR_YEAR}"},
            {"label": "Nature dominante", "agg": "top", "from": "DIM_COUNTS.Categorie", "fmt": "text", "sub": "du flux"},
            {"label": "Poste le plus important", "agg": "top", "from": "DIM_COUNTS.SousFamille", "fmt": "text", "sub": "du flux"}
          ],
          "visuals": [
            {"type": "donut", "from": "BY_DIM.Categorie.MONTANT", "top": 6, "title": "Répartition du flux par nature", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"},
            {"type": "hbar", "from": "BY_DIM.SousFamille.MONTANT", "top": 10, "title": "Top postes financiers", "unit": "int", "sub": "k€ · année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.SousFamille.MONTANT", "title": "Détail par poste financier", "sortBy": "measure:MONTANT", "cols": [
              {"label": "Poste", "name": "name"},
              {"label": "Réalisé", "source": "measure:MONTANT", "fmt": "int", "num": true},
              {"label": "Prévu", "source": "measure:MONTANT_PREVU", "fmt": "int", "num": true}
            ]},
            {"type": "donut", "from": "BY_DIM.Zone.MONTANT", "top": 6, "title": "Flux par zone", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"}
          ]
        }
      ]
    },
    {
      "name": "Trésorerie & Cash",
      "desc": "Liquidités, délais de paiement clients (DSO), encours de créances et réalisation budgétaire.",
      "subs": [
        {
          "name": "Liquidités & encours",
          "kpis": [
            {"label": "Clients actifs", "agg": "active", "yoy": true, "fmt": "int", "sub": "facturés en {CUR_YEAR}"},
            {"label": "DSO moyen", "agg": "scalar", "from": "SCALARS.AVG_DELAI_PAIEMENT", "fmt": "int", "sub": "jours · {CUR_YEAR}"},
            {"label": "Encours moyen des créances", "agg": "scalar", "from": "SCALARS.AVG_MONTANT_DU", "fmt": "int", "sub": "k€ · {CUR_YEAR}"},
            {"label": "Créances au portefeuille", "agg": "scalar", "from": "SCALARS.NB_FAIT_CREANCE", "fmt": "int", "sub": "lignes · {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "line", "measure": "MONTANT", "title": "Flux financier par mois", "unit": "int", "unitLabel": "k€"},
            {"type": "donut", "from": "CATEGORY_COUNTS.FAIT_CREANCE.Statut", "top": 6, "title": "Créances par statut", "unit": "int", "centerSub": "créances", "sub": "année {CUR_YEAR}"},
            {"type": "donut", "from": "BY_DIM.Segment.MONTANT", "top": 6, "title": "Flux par segment client", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"},
            {"type": "hbar", "from": "BY_DIM.Zone.MONTANT", "top": 10, "title": "Flux par zone", "unit": "int", "sub": "k€ · année {CUR_YEAR}"}
          ]
        },
        {
          "name": "Réalisation budgétaire",
          "kpis": [
            {"label": "Budget annuel", "agg": "sum", "measure": "MONTANT_PREVU", "yoy": true, "fmt": "int", "sub": "k€ prévus en {CUR_YEAR}"},
            {"label": "Écart réalisé vs prévu", "agg": "ratio", "num": "MONTANT", "den": "MONTANT_PREVU", "yoy": true, "fmt": "pct", "sub": "{CUR_YEAR}"},
            {"label": "Flux moyen par écriture", "agg": "ratio", "num": "MONTANT", "den": "_count", "yoy": true, "fmt": "f1", "sub": "k€ / écriture · {CUR_YEAR}"},
            {"label": "Écritures traitées", "agg": "sum", "measure": "_count", "yoy": true, "fmt": "int", "sub": "en {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "line", "measure": "MONTANT_PREVU", "title": "Budget par mois", "unit": "int", "unitLabel": "k€"},
            {"type": "ratio-line", "num": "MONTANT", "den": "MONTANT_PREVU", "title": "Réalisation mensuelle du budget", "unit": "pct"},
            {"type": "donut", "from": "BY_DIM.Categorie.MONTANT", "top": 6, "title": "Répartition par nature", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"},
            {"type": "hbar", "from": "BY_DIM.SousFamille.MONTANT", "top": 10, "title": "Top postes", "unit": "int", "sub": "k€ · année {CUR_YEAR}"}
          ]
        }
      ]
    },
    {
      "name": "Investissements & Rentabilité",
      "desc": "Portefeuille d'investissements, rendement (ROI), enveloppes et solvabilité mesurée par la réalisation budgétaire.",
      "subs": [
        {
          "name": "Portefeuille d'investissements",
          "kpis": [
            {"label": "ROI moyen", "agg": "scalar", "from": "SCALARS.AVG_ROI", "fmt": "pct", "sub": "portefeuille {CUR_YEAR}"},
            {"label": "Enveloppe moyenne par projet", "agg": "scalar", "from": "SCALARS.AVG_MONTANT", "fmt": "int", "sub": "k€ / projet · {CUR_YEAR}"},
            {"label": "Projets suivis", "agg": "scalar", "from": "SCALARS.NB_FAIT_INVESTISSEMENT", "fmt": "int", "sub": "au portefeuille · {CUR_YEAR}"},
            {"label": "Statut dominant", "agg": "top", "from": "CATEGORY_COUNTS.FAIT_INVESTISSEMENT.Statut", "fmt": "text", "sub": "portefeuille"}
          ],
          "visuals": [
            {"type": "donut", "from": "CATEGORY_COUNTS.FAIT_INVESTISSEMENT.Statut", "top": 6, "title": "Projets par statut", "unit": "int", "centerSub": "projets", "sub": "année {CUR_YEAR}"},
            {"type": "line", "measure": "MONTANT", "title": "Flux financier par mois", "unit": "int", "unitLabel": "k€"},
            {"type": "donut", "from": "BY_DIM.Segment.MONTANT", "top": 6, "title": "Flux par segment client", "unit": "int", "unitLabel": "k€", "centerSub": "flux k€", "sub": "année {CUR_YEAR}"},
            {"type": "hbar", "from": "BY_DIM.Zone.MONTANT", "top": 10, "title": "Flux par zone", "unit": "int", "sub": "k€ · année {CUR_YEAR}"}
          ]
        },
        {
          "name": "ROI & solvabilité",
          "kpis": [
            {"label": "ROI moyen", "agg": "scalar", "from": "SCALARS.AVG_ROI", "fmt": "pct", "sub": "portefeuille {CUR_YEAR}"},
            {"label": "Réalisation budgétaire", "agg": "ratio", "num": "MONTANT", "den": "MONTANT_PREVU", "yoy": true, "fmt": "pct", "sub": "{CUR_YEAR}"},
            {"label": "Flux moyen par écriture", "agg": "ratio", "num": "MONTANT", "den": "_count", "yoy": true, "fmt": "f1", "sub": "k€ / écriture · {CUR_YEAR}"},
            {"label": "Créances au portefeuille", "agg": "scalar", "from": "SCALARS.NB_FAIT_CREANCE", "fmt": "int", "sub": "lignes · {CUR_YEAR}"}
          ],
          "visuals": [
            {"type": "ratio-line", "num": "MONTANT", "den": "MONTANT_PREVU", "title": "Réalisation mensuelle du budget", "unit": "pct"},
            {"type": "line", "measure": "MONTANT_PREVU", "title": "Budget par mois", "unit": "int", "unitLabel": "k€"},
            {"type": "donut", "from": "CATEGORY_COUNTS.FAIT_INVESTISSEMENT.Statut", "top": 6, "title": "Projets par statut", "unit": "int", "centerSub": "projets", "sub": "année {CUR_YEAR}"},
            {"type": "table", "from": "BY_DIM.SousFamille.MONTANT", "title": "Détail par poste financier", "sortBy": "measure:MONTANT", "cols": [
              {"label": "Poste", "name": "name"},
              {"label": "Réalisé", "source": "measure:MONTANT", "fmt": "int", "num": true},
              {"label": "Prévu", "source": "measure:MONTANT_PREVU", "fmt": "int", "num": true}
            ]}
          ]
        }
      ]
    }
  ]
}
